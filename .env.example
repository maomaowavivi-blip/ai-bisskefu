DB_HOST=localhost
DB_PORT=3306
DB_NAME=aibisskefu_com
DB_USER=aibisskefu_com
DB_PASS=your_db_password
JWT_SECRET=replace_with_a_random_secret

# Sidecar 房间知识库（宿家 AI 查询库）
SIDECAR_DB_HOST=127.0.0.1
SIDECAR_DB_PORT=8889
SIDECAR_DB_NAME=sujia_ai_sidecar_dev
SIDECAR_DB_USER=root
SIDECAR_DB_PASS=root

# SMS 验证码（阿里云短信）
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=XX客服
SMS_TEMPLATE_CODE=SMS_XXXXXX

# AI 主聊天（默认 DeepSeek V4 Flash，见 api/config.php callAI）
# 也可在 admin 系统设置中配置 ai.api_key
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# Embedding 向量（Sidecar + KB 语义检索，MiniMax embo-01）
MINIMAX_API_KEY=
MINIMAX_EMBEDDING_MODEL=embo-01
MINIMAX_EMBEDDING_URL=https://api.minimaxi.com/v1/embeddings
